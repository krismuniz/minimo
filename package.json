{
  "name": "minimo",
  "version": "1.5.0",
  "description": "An elegant, minimal new tab page for Chrome",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,json,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,html,css}\"",
    "check": "npm run format:check && npm run lint"
  },
  "keywords": [
    "chrome-extension",
    "new-tab",
    "productivity",
    "minimal"
  ],
  "author": "Kristian Muñiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krismuniz/minimo.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.13.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
